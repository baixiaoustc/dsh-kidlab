{
  "name": "@kidlab/dsh-kid-sysmon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MacBook 资源使用情况监控工具插件（DeepSeek Harness / Cordis）：查询 CPU、内存、磁盘、网络、电池、负载与 Top 进程的真实数据（免 sudo，无需第三方依赖）。",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "build:emit": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  }
}