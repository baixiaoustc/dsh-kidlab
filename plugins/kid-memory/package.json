{
  "name": "@kidlab/dsh-kid-memory",
  "version": "0.2.0",
  "type": "module",
  "description": "给小朋友的内存启蒙插件：一个包 = 一张 🦉「记忆小管家·电脑的工作台」卡片 + 四个模型工具（mem_now / mem_pressure / mem_workbench / mem_top），零第三方依赖、无构建步骤。",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "tools.js",
    "collect.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "kid",
    "memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baixiaoustc/dsh-kidlab.git",
    "directory": "plugins/kid-memory"
  },
  "homepage": "https://github.com/baixiaoustc/dsh-kidlab#readme",
  "bugs": {
    "url": "https://github.com/baixiaoustc/dsh-kidlab/issues"
  },
  "author": "baixiaoustc",
  "publishConfig": {
    "access": "public"
  }
}
